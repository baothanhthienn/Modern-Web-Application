# Public backend endpoint used by the Vue frontend.
VITE_API_BASE_URL=https://modern-web-application-backend-production.up.railway.app/api

# To run against a local backend instead:
# VITE_API_BASE_URL=http://localhost:3000/api

# Cloudinary — required for profile picture upload.
# Create a free account at https://cloudinary.com, then copy your cloud name
# and create an unsigned upload preset under Settings → Upload.
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
